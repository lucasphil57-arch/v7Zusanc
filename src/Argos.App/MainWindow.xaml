<Window x:Class="Argos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Argos.Core.Models;assembly=Argos.Core"
        Title="Argos" Height="840" Width="1340" MinHeight="600" MinWidth="980"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="ARGOS" Foreground="{StaticResource Acc}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TokenState" Text="token absent" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
          <PasswordBox x:Name="TokenBox" Width="230" Padding="9,7" Background="{StaticResource Card}" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}" FontSize="11"/>
          <Button Content="Verifier" Margin="8,0,0,0" Click="OnToken"/>
        </StackPanel>
        <ComboBox x:Name="TypeBox" Width="130" SelectedIndex="0" Margin="0,0,8,0">
          <ComboBoxItem Content="ID Discord"/>
          <ComboBoxItem Content="Pseudo"/>
          <ComboBoxItem Content="Email"/>
          <ComboBoxItem Content="Telephone"/>
          <ComboBoxItem Content="Nom"/>
          <ComboBoxItem Content="Adresse"/>
        </ComboBox>
        <Button Content="Export" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnExport"/>
        <Button Content="Lancer" Style="{StaticResource Primary}" DockPanel.Dock="Right" Click="OnSeed"/>
        <TextBox x:Name="SeedBox" FontFamily="Consolas" KeyDown="OnSeedKey"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10">
        <DockPanel>
          <Button DockPanel.Dock="Top" Content="Nouveau dossier" Click="OnNewCase" Margin="0,0,0,10"/>
          <ListBox x:Name="CaseList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                   SelectionChanged="OnCaseChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Padding="6,7" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="2">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="#1A1E26"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="{StaticResource Acc}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
          <TextBlock x:Name="EmptyText" Text="Aucune entite. Saisis un identifiant puis Lancer."
                     Foreground="{StaticResource Dim}" Margin="2,6,0,14" TextWrapping="Wrap"/>
          <ItemsControl x:Name="Feed">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,0,8" Padding="0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="Bar" Grid.Column="0" Fill="{StaticResource Dim}"/>
                    <StackPanel Grid.Column="1" Margin="12,9,12,9">
                      <TextBlock Text="{Binding Header}" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Value}" Foreground="{StaticResource Fg}" FontFamily="Consolas"
                                 FontSize="12" TextWrapping="Wrap" Margin="0,3,0,3"/>
                      <TextBlock Text="{Binding Source}" Foreground="{StaticResource Dim}" FontSize="9.5"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Type}" Value="{x:Static core:NodeType.DiscordId}">
                    <Setter TargetName="Bar" Property="Fill" Value="{StaticResource Acc}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Type}" Value="{x:Static core:NodeType.Email}">
                    <Setter TargetName="Bar" Property="Fill" Value="#F59E0B"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Type}" Value="{x:Static core:NodeType.Phone}">
                    <Setter TargetName="Bar" Property="Fill" Value="#22C55E"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Type}" Value="{x:Static core:NodeType.RealName}">
                    <Setter TargetName="Bar" Property="Fill" Value="#EF4444"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Type}" Value="{x:Static core:NodeType.Username}">
                    <Setter TargetName="Bar" Property="Fill" Value="#8B5CF6"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="PIVOTS" Foreground="{StaticResource Dim}" FontSize="10" FontWeight="Bold" Margin="14,12,0,8"/>
          <ListBox x:Name="PivotList" Grid.Row="1" Background="Transparent" BorderThickness="0" MouseDoubleClick="OnPivot">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="6,5">
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource Fg}" FontWeight="SemiBold"/>
                  <TextBlock Foreground="{StaticResource Dim}" FontSize="9.5">
                    <Run Text="{Binding YieldText}"/><Run Text="   "/><Run Text="{Binding Why}"/>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" Background="{StaticResource Bg}"
                   Foreground="{StaticResource Mut}" BorderThickness="0" FontFamily="Consolas" FontSize="10"
                   Padding="12,8" VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
      <TextBlock x:Name="StatusText" Text="pret" Foreground="{StaticResource Mut}" FontSize="11"/>
    </Border>
  </Grid>
</Window>