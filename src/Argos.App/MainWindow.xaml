<Window x:Class="Argos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Argos" Height="840" Width="1340" MinHeight="620" MinWidth="1000"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Left" Text="ARGOS" Foreground="{StaticResource Acc}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
          <Button Content="Export" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnExport"/>
          <Button Content="Lancer" DockPanel.Dock="Right" Margin="8,0,0,0" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="OnSeed"/>
          <ComboBox x:Name="TypeBox" Width="128" SelectedIndex="0" Margin="0,0,8,0">
            <ComboBoxItem Content="ID Discord"/>
            <ComboBoxItem Content="Pseudo"/>
            <ComboBoxItem Content="Email"/>
            <ComboBoxItem Content="Telephone"/>
            <ComboBoxItem Content="Nom"/>
            <ComboBoxItem Content="Adresse"/>
          </ComboBox>
          <TextBox x:Name="SeedBox" FontFamily="Consolas" KeyDown="OnSeedKey"/>
        </DockPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="TOKEN DISCORD" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Width="110"/>
          <TextBlock x:Name="TokenState" DockPanel.Dock="Right" Text="absent" Foreground="{StaticResource Dim}" VerticalAlignment="Center" FontSize="10.5" Margin="10,0,0,0" MinWidth="120"/>
          <Button DockPanel.Dock="Right" Content="Verifier" Margin="8,0,0,0" Click="OnToken"/>
          <Button DockPanel.Dock="Right" Content="Coller" Margin="8,0,0,0" Click="OnPaste"/>
          <PasswordBox x:Name="TokenBox" Padding="9,6" Background="{StaticResource Card}" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}" FontFamily="Consolas" FontSize="11" KeyDown="OnTokenKey"/>
        </DockPanel>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10">
        <DockPanel>
          <Button DockPanel.Dock="Top" Content="Nouveau dossier" Click="OnNewCase" Margin="0,0,0,10"/>
          <ListBox x:Name="CaseList" SelectionChanged="OnCaseChanged"/>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
          <TextBlock x:Name="EmptyText" Text="Aucune entite. Saisis un identifiant puis Lancer." Foreground="{StaticResource Dim}" Margin="2,4,0,14" TextWrapping="Wrap"/>
          <ItemsControl x:Name="Feed">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{Binding Accent}"/>
                    <StackPanel Grid.Column="1" Margin="12,9,12,9">
                      <TextBlock Text="{Binding Header}" Foreground="{StaticResource Dim}" FontSize="9.5" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Value}" Foreground="{StaticResource Fg}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                      <TextBlock Text="{Binding Source}" Foreground="{StaticResource Dim}" FontSize="9.5"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="PIVOTS" Foreground="{StaticResource Dim}" FontSize="10" FontWeight="Bold" Margin="14,12,0,8"/>
          <ListBox x:Name="PivotList" Grid.Row="1" MouseDoubleClick="OnPivot">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource Fg}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Dim}" FontSize="9.5"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" Background="{StaticResource Bg}" Foreground="{StaticResource Mut}" BorderThickness="0" FontFamily="Consolas" FontSize="10" Padding="12,8" VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
      <TextBlock x:Name="StatusText" Text="pret" Foreground="{StaticResource Mut}" FontSize="11"/>
    </Border>
  </Grid>
</Window>

